{
  "name": "lab-mango-docs",
  "private": true,
  "version": "0.0.0",
  "description": "Lab Mango documentation site: user guides and synced developer docs.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "start": "npm run sync && docusaurus start --port 3001",
    "build": "npm run sync && docusaurus build",
    "serve": "docusaurus serve --port 3001",
    "clear": "docusaurus clear",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 3 chrome version", "last 3 firefox version", "last 5 safari version"]
  }
}
